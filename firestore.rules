rules_version = '2';

// NEXUS ERP — Interim Tenant-Isolation Rules (Phase 2)
// - ต้องเป็น "สมาชิก" (มีเอกสาร users/{uid}) หรือ SUPERADMIN จึงใช้งานได้: บัญชีที่สมัครตรงกับ Firebase Auth แต่ไม่มีโปรไฟล์จะถูกปฏิเสธ
// - companies/{companyId}/** เข้าถึงได้เฉพาะสมาชิกบริษัทนั้น (ใช้ users/{uid}.companyId ไม่ต้องตั้ง Custom Claims)
// - Root collections: อ่าน/เขียนได้เฉพาะเอกสารบริษัทตัวเอง (query ฝั่ง client ต้องมี where("companyId", "==", ...) เสมอ)
// - Audit log เขียนได้อย่างเดียว ห้ามแก้/ลบ; counters และ periodClosings เขียนได้ผ่าน Admin SDK (API) เท่านั้น
// - เอกสารที่มี API ดูแลสถานะ (ใบเสร็จ ใบสำคัญจ่าย เงินเดือน พนักงาน ลงเวลา หมายเลขเครื่อง) เขียนผ่าน API เท่านั้น
// - ใบเสนอราคา: สร้าง/แก้/อนุมัติ/ออกฉบับแก้ไขผ่าน API เท่านั้น ลบจากหน้าจอได้เฉพาะใบที่ยังไม่ส่งลูกค้า
// ชุดเป้าหมายแบบเข้มงวด (Custom Claims + server-only journal) อยู่ที่ firestore.strict.rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ให้ตรงกับ SUPERADMIN ใน AuthContext / api-auth.ts
    function isSuperAdmin() {
      return signedIn() && (
        request.auth.uid == 'fgIglIug2dh4aNMMeachaugIyFM2' ||
        request.auth.token.email == 'sadmin@admin.com'
      );
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isMember() {
      return isSuperAdmin() || hasProfile();
    }

    // ตำแหน่งของผู้ใช้: roles[] (กำหนดโดย SUPERADMIN) หรือ role เดียวแบบเก่า — ตรงกับ src/lib/permissions.ts
    function myRoles() {
      return profile().get('roles', [string(profile().get('role', '')).upper()]);
    }

    // บัญชีรุ่นเก่า ADMIN/MANAGER ที่ยังไม่มี roles[] ได้สิทธิ์ครบเหมือนเดิม
    function legacyFullAccess() {
      return !('roles' in profile()) && string(profile().get('role', '')).upper() in ['ADMIN', 'MANAGER'];
    }

    function hasRole(list) {
      return isSuperAdmin() || (hasProfile() && (legacyFullAccess() || myRoles().hasAny(list)));
    }

    // อ่านข้อมูลบัญชี/การเงินได้: ฝ่ายบัญชีและผู้บริหาร
    function financeReader() {
      return hasRole(['ACCOUNTANT', 'EXECUTIVE']);
    }

    function myCompany() {
      return profile().companyId;
    }

    function inCompany(companyId) {
      return isSuperAdmin() || (hasProfile() && myCompany() == companyId);
    }

    // ผู้ดูแลระบบของบริษัท: ตำแหน่ง ADMIN (roles[] ใหม่ หรือ role เดียวแบบเก่า)
    function isCompanyAdmin() {
      return hasProfile() && (
        profile().get('role', '') in ['ADMIN', 'admin', 'Admin'] ||
        'ADMIN' in profile().get('roles', [])
      );
    }

    // เอกสารที่จะเขียน: ถ้ามี companyId ต้องเป็นบริษัทของผู้ใช้
    function newDataInMyCompany() {
      return !('companyId' in request.resource.data) || inCompany(request.resource.data.companyId);
    }

    // เอกสารเดิม: ถ้ามี companyId ต้องเป็นบริษัทของผู้ใช้
    function existingInMyCompany() {
      return !('companyId' in resource.data) || inCompany(resource.data.companyId);
    }

    // อ่านเอกสารเดียว: เอกสารที่ไม่มีอยู่จริงอ่านได้ (ใช้เช็กการมีอยู่) ที่เหลือต้องเป็นบริษัทตัวเอง
    function canGet() {
      return resource == null || isSuperAdmin() || (hasProfile() && resource.data.get('companyId', null) == myCompany());
    }

    // query หลายเอกสาร: ต้องกรอง companyId เป็นบริษัทตัวเอง (SUPERADMIN query ได้ทั้งหมด)
    function canList() {
      return isSuperAdmin() || (hasProfile() && resource.data.companyId == myCompany());
    }

    // ---------- Root collections (generic) ----------
    // collection ที่มีกฎเฉพาะด้านล่างถูกตัดออกจาก wildcard เพื่อไม่ให้ wildcard อนุญาตทับ
    function isSpecialRoot(collectionName) {
      return collectionName in ['users', 'companies', 'counters', 'periodClosings', 'logs', 'activity_logs', 'employees', 'attendance', 'journal_entries', 'taxFilings', 'assetDepreciations', 'service_tickets', 'rate_limits', 'document_shares', 'groups', 'products', 'suppliers', 'contractors', 'customers'];
    }

    match /{collectionName}/{documentId} {
      allow get: if isMember() && !isSpecialRoot(collectionName) && canGet();
      allow list: if isMember() && !isSpecialRoot(collectionName) && canList();
      allow create: if isMember() && !isSpecialRoot(collectionName) && newDataInMyCompany();
      allow update: if isMember() && !isSpecialRoot(collectionName) && existingInMyCompany() && newDataInMyCompany();
      allow delete: if isMember() && !isSpecialRoot(collectionName) && existingInMyCompany();
    }

    // ---------- Users (profile = สิทธิ์และบริษัท ห้ามแก้ของตัวเอง) ----------
    match /users/{userId} {
      allow read: if signedIn() && (
        userId == request.auth.uid ||
        isSuperAdmin() ||
        (hasProfile() && resource.data.companyId == myCompany())
      );
      // สร้างบัญชี/อนุมัติ/กำหนดตำแหน่ง ผ่าน /api/admin/users เท่านั้น (กำหนดตำแหน่งได้เฉพาะ SUPERADMIN)
      // ADMIN แก้ข้อมูลทั่วไปของผู้ใช้บริษัทตัวเองได้ แต่แตะตำแหน่ง บริษัท และสถานะไม่ได้
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isCompanyAdmin() &&
        resource.data.companyId == myCompany() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles', 'companyId', 'status'])
      );
      allow delete: if isSuperAdmin() || (isCompanyAdmin() && resource.data.companyId == myCompany());
    }

    // ---------- Locked collections (Admin SDK / API only) ----------
    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /periodClosings/{periodId} {
      allow get: if isMember() && canGet();
      allow list: if isMember() && canList();
      allow write: if false; // ปิด/เปิดงวดผ่าน /api/accounting/period-close|period-reopen เท่านั้น
    }

    // รายการบัญชีรุ่นเก่า / ประวัติการยื่นภาษี / การประมวลผลค่าเสื่อม: อ่านได้ เขียนผ่าน API เท่านั้น
    match /journal_entries/{entryId} {
      allow get: if financeReader() && canGet();
      allow list: if financeReader() && canList();
      allow write: if false;
    }
    match /taxFilings/{filingId} {
      allow get: if financeReader() && canGet();
      allow list: if financeReader() && canList();
      allow write: if false; // /api/finance/tax-filings
    }
    match /assetDepreciations/{runId} {
      allow get: if financeReader() && canGet();
      allow list: if financeReader() && canList();
      allow write: if false; // /api/finance/depreciation
    }

    // พนักงานและการลงเวลา: อ่านได้ภายในบริษัท เขียนผ่าน /api/hr/* เท่านั้น
    // ข้อมูลพนักงาน (มีเงินเดือน/บัญชีธนาคาร): บุคคล บัญชี ผู้บริหาร — ตำแหน่งอื่นใช้ /api/hr/directory
    match /employees/{employeeId} {
      allow get: if hasRole(['HR', 'ACCOUNTANT', 'EXECUTIVE']) && canGet();
      allow list: if hasRole(['HR', 'ACCOUNTANT', 'EXECUTIVE']) && canList();
      allow write: if false;
    }

    match /attendance/{recordId} {
      allow get: if hasRole(['HR', 'ACCOUNTANT', 'EXECUTIVE']) && canGet();
      allow list: if hasRole(['HR', 'ACCOUNTANT', 'EXECUTIVE']) && canList();
      allow write: if false;
    }

    // ข้อมูลหลักรุ่นเก่าที่ root (ก่อนย้ายเข้าข้อมูลกลางของเครือ): อ่านได้ในบริษัท เขียนผ่าน /api/master-data เท่านั้น
    match /{masterCol}/{docId} {
      allow get: if masterCol in ['products', 'suppliers', 'contractors', 'customers'] && isMember() && canGet();
      allow list: if masterCol in ['products', 'suppliers', 'contractors', 'customers'] && isMember() && canList();
      allow write: if false;
    }

    // คำขอแจ้งซ่อมจากพอร์ทัลรุ่นเก่า: อ่านได้ในบริษัท (รอรับเรื่อง) — คำขอใหม่เข้า /api/portal/repair
    // rate_limits: ตัวนับของ endpoint สาธารณะ อยู่ใน isSpecialRoot และไม่มีกฎ = client เข้าไม่ได้
    match /service_tickets/{ticketId} {
      allow get: if isMember() && canGet();
      allow list: if isMember() && canList();
      allow write: if false;
    }

    // ---------- เครือบริษัท: ข้อมูลกลาง (สินค้า ลูกค้า ผู้ขาย ผู้รับเหมา) ----------
    // เครือของผู้ใช้ = companies/{บริษัทของผู้ใช้}.groupId (ไม่มี = รหัสบริษัทเอง)
    function myGroup() {
      return get(/databases/$(database)/documents/companies/$(myCompany())).data.get('groupId', myCompany());
    }
    function inGroup(groupId) {
      return isSuperAdmin() || (hasProfile() && myGroup() == groupId);
    }
    match /groups/{groupId} {
      allow read: if inGroup(groupId);
      allow write: if isSuperAdmin();
      // ข้อมูลกลางและดัชนีห้ามซ้ำ: อ่านได้ทั้งเครือ เขียนผ่าน /api/master-data เท่านั้น
      match /{collection}/{docId} {
        allow read: if inGroup(groupId);
        allow write: if false;
      }
      match /{collection}/{docId}/{sub}/{rest=**} {
        allow read: if inGroup(groupId);
        allow write: if false;
      }
    }

    // ---------- Append-only audit logs ----------
    match /logs/{logId} {
      allow get: if isMember() && canGet();
      allow list: if isMember() && canList();
      allow create: if isMember() && newDataInMyCompany();
      allow update, delete: if false;
    }

    match /activity_logs/{logId} {
      allow get: if isMember() && canGet();
      allow list: if isMember() && canList();
      allow create: if isMember() && newDataInMyCompany();
      allow update, delete: if false;
    }

    // ---------- Tenant-scoped company tree ----------
    match /companies/{companyId} {
      // ข้อมูลบริษัท (ชื่อ เลขผู้เสียภาษี สาขา สถานะ VAT) พิมพ์บนใบกำกับภาษี: แก้ผ่าน /api/settings/* ตามสิทธิ์เท่านั้น
      allow read: if inCompany(companyId);
      allow update: if false;
      allow create, delete: if isSuperAdmin();

      // ทุก subcollection (และลึกกว่านั้น) ยกเว้นที่มีกฎเฉพาะ
      function apiOnlyCollection(collection) {
        return collection in ['auditLogs', 'financialLedgers', 'quotations', 'receipts', 'payments', 'payrolls', 'serial_numbers', 'invoices', 'billing_notes', 'cndn', 'customer_refunds', 'counters', 'journal_entries', 'tax_filing_locks',
          // จัดซื้อ / ค่าใช้จ่าย / ขาย / งานบริการ: ออกเลข ตรวจสถานะ และอนุมัติที่ server
          'purchase_requests', 'purchase_orders', 'expenses', 'withholding_taxes', 'sales_orders', 'work_orders', 'delivery_notes', 'cash_advances',
          // ลิงก์เอกสารและประวัติการส่ง: สร้าง/ส่งผ่าน /api/documents/share และ /api/documents/send
          'document_sends',
          // ตั้งค่าบริษัท (รูปแบบเลขที่เอกสาร ฯลฯ): /api/settings/company เท่านั้น
          'settings',
          // ทะเบียนบัญชีธนาคาร เช็ค และการกระทบยอด: บันทึกผ่าน /api/finance/* เท่านั้น
          'bank_accounts', 'cheques', 'bank_reconciliations',
          // งานมอบหมาย: จ่ายงาน/รับงาน/ปิดงานผ่าน /api/jobs เท่านั้น
          'jobs', 'service_tickets',
          // คำขอแจ้งซ่อมจากลูกค้า: รับผ่าน /api/portal/repair และรับเรื่องผ่าน /api/service/tickets
          'portal_requests',
          // ข้อมูลหลักส่วนของบริษัท (ราคา สต็อก วงเงิน ชื่อเฉพาะบริษัท): /api/master-data และ stock engine
          'products', 'customers', 'suppliers', 'contractors'];
      }
      // ข้อมูลการเงินอ่านได้เฉพาะตำแหน่งที่เกี่ยวข้อง (ส่วนอื่นอ่านได้ทุกคนในบริษัท)
      function restrictedRead(collection) {
        return collection in ['journal_entries', 'payments', 'financialLedgers', 'tax_filing_locks', 'customer_refunds', 'payrolls', 'expenses', 'withholding_taxes', 'cheques', 'bank_reconciliations'];
      }
      function canReadCollection(collection) {
        return !restrictedRead(collection) || (
          collection == 'payrolls' ? hasRole(['ACCOUNTANT', 'EXECUTIVE', 'HR'])
          : collection in ['expenses', 'withholding_taxes'] ? hasRole(['ACCOUNTANT', 'EXECUTIVE', 'PURCHASING', 'WAREHOUSE', 'HR'])
          : financeReader()
        );
      }
      match /{collection}/{docId} {
        allow read: if inCompany(companyId) && canReadCollection(collection);
        allow write: if inCompany(companyId) && !apiOnlyCollection(collection);
      }
      match /{collection}/{docId}/{sub}/{rest=**} {
        allow read: if inCompany(companyId) && canReadCollection(collection);
        // คำขอเปลี่ยนแปลงโครงการ: ยื่น/อนุมัติผ่าน /api/projects/change-orders เท่านั้น
        allow write: if (inCompany(companyId) && !apiOnlyCollection(collection)
          && !(collection == 'projects' && sub == 'change_orders'))
          // ยกเว้นรูปถ่าย/ลายเซ็นหน้างานของใบสั่งงาน (เช็คอิน/ปิดงานผ่าน /api/service/work-orders)
          || (inCompany(companyId) && collection == 'work_orders' && sub == 'attachments');
      }

      // receipts / payments / payrolls / serial_numbers: อ่านได้ตามกฎด้านบน เขียนผ่าน API เท่านั้น (ตรวจยอดค้าง กลับรายการบัญชี ออกเลขที่ในทรานแซกชัน)
      // ใบกำกับภาษี / ใบวางบิล / ใบลดหนี้-เพิ่มหนี้: ออกผ่าน /api/sales/* เท่านั้น (เลขต้องเรียงต่อเนื่อง)
      // ลบจากหน้าจอได้เฉพาะเอกสารตัวอย่าง
      match /invoices/{invoiceId} {
        allow delete: if inCompany(companyId) && resource.data.get('isSample', false) == true;
      }

      // ใบเสนอราคา
      function quotationEditable(data) {
        return data.get('status', 'DRAFT') in ['DRAFT', 'Draft', 'draft', 'REJECTED', 'Rejected', 'rejected'];
      }

      match /quotations/{quotationId} {
        allow read: if inCompany(companyId);
        // สร้าง/แก้/อนุมัติ/ออกฉบับแก้ไข ผ่าน /api/quotations/* เท่านั้น (ออกเลขที่และตรวจ GP ฝั่งเซิร์ฟเวอร์)
        allow create, update: if false;
        allow delete: if inCompany(companyId) && quotationEditable(resource.data);

        match /{sub}/{subId} {
          allow read: if inCompany(companyId);
          allow write: if false;
        }
      }

      match /auditLogs/{logId} {
        allow create: if inCompany(companyId);
        allow update, delete: if false;
      }

      // เอกสารบัญชีที่ POSTED แล้วห้ามแก้/ลบ (แก้ผ่าน Reverse Entry เท่านั้น)
      match /financialLedgers/{ledgerId} {
        allow create: if inCompany(companyId);
        allow update: if inCompany(companyId) && resource.data.status != 'POSTED';
        allow delete: if false;
      }
    }
  }
}
