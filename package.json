{
  "name": "nexus-erp",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check:company-id": "node scripts/check-company-id.js",
    "check:hex-tokens": "node scripts/check-hex-tokens.js",
    "check:thai-labels": "node scripts/check-thai-labels.js",
    "check:layout": "node scripts/run-layout-audit.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nexus \"node scripts/test-tenant-rules.js\"",
    "check:static": "npm run -s check:company-id && npm run -s check:hex-tokens && npm run -s check:thai-labels",
    "postinstall": "patch-package",
    "test:e2e": "node tests/e2e/run.cjs",
    "check:data": "node tests/e2e/tools/checks.cjs",
    "backup:firestore": "node scripts/backup-firestore.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.21.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-font-family": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bahttext": "^2.4.0",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.10.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.453.0",
    "next": "^16.2.12",
    "nodemailer": "^10.1.2",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "thailand-address": "^1.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "15.0.0",
    "firebase-tools": "^15.31.0",
    "iconv-lite": "^0.7.3",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
